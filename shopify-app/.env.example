# Vorlage für .env (lokale Entwicklung). Kopieren nach .env und Werte eintragen.
# Die echte .env wird nie hochgeladen.
#
# Datenbank-Benutzer ommetryx_dev mit eigenem Passwort, Datenbank ommetryx, Bereich app.
DATABASE_URL="postgresql://ommetryx_dev:PASSWORT@localhost:5432/ommetryx?schema=app"

# Schlüssel für verschlüsselte Zwei-Faktor-Geheimnisse (32 Byte, base64). Erzeugen z. B. mit:
# node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64\"))"
INTERN_SCHLUESSEL="BASE64_SCHLUESSEL"

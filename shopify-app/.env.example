# Vorlage für .env (lokale Entwicklung). Kopieren nach .env und Werte eintragen.
# Die echte .env wird nie hochgeladen.
#
# Laufzeit: drei Datenbank-Benutzer mit getrennten Rechten (prisma/rechte.sql)
DATABASE_URL="postgresql://ommetryx_app:PASSWORT@localhost:5432/ommetryx?schema=app"
DATABASE_URL_IDENTITY="postgresql://ommetryx_identity:PASSWORT@localhost:5432/ommetryx?schema=identity"
DATABASE_URL_BODY="postgresql://ommetryx_body:PASSWORT@localhost:5432/ommetryx?schema=body"
# Migrationen und Rechte: Besitzer der Datenbank
DIRECT_DATABASE_URL="postgresql://ommetryx_dev:PASSWORT@localhost:5432/ommetryx?schema=app"

# Schlüssel (je 32 Byte, base64). Erzeugen z. B. mit:
# node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64\"))"
INTERN_SCHLUESSEL="BASE64_SCHLUESSEL"
OX_SCHLUESSEL_IDENTITY="BASE64_SCHLUESSEL"
OX_SCHLUESSEL_BODY="BASE64_SCHLUESSEL"
OX_HASH_SCHLUESSEL="BASE64_SCHLUESSEL"

# Nur auf dem Server nötig (lokal setzt die Shopify CLI die Shopify-Werte selbst,
# Mails landen im Entwicklungs-Postfach):
# BREVO_API_KEY=""
# OX_MAIL_ABSENDER="absender@eure-domain.de"
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# SHOPIFY_APP_URL="https://..."
# SCOPES="write_products,write_app_proxy"

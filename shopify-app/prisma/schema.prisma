// Datenbank-Schema von Ommetryx (PostgreSQL).
// Drei getrennte Bereiche (Datenschutz, CLAUDE.md Abschnitt 9):
//   app      – Shops, Konfiguration, später Artikel und Empfehlungen (keine Körpermaße)
//   identity – später E-Mail, Login, Einwilligungen
//   body     – später Körpermaße, nur über pseudonym_id
// Mehr dazu: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "identity", "body"]
}

// Shopify-Anmeldung des Händlers (aus dem Template).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("app")
}

// ---------------------------------------------------------------------------
// Konfiguration der Empfehlungslogik.
// Je Blatt der Excel-Datei eine Tabelle, alles an eine Version gebunden („v3“).
// Startwerte: npm run db:startwerte (liest packages/empfehlung/konfiguration/*.json).
// ---------------------------------------------------------------------------

model KonfigVersion {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  aktiv      Boolean  @default(false)
  quelle     String
  erstelltAm DateTime @default(now()) @map("erstellt_am")

  bereiche          KonfigBereich[]
  mindest           KonfigMindest[]
  dehnungsklassen   KonfigDehnungsklasse[]
  dehnungskorrektur KonfigDehnungskorrektur[]
  gewichte          KonfigGewicht[]
  parameter         KonfigParameter[]
  ergaenzung        KonfigErgaenzung?

  @@map("konfig_version")
  @@schema("app")
}

model KonfigBereich {
  id                     Int     @id @default(autoincrement())
  versionId              Int     @map("version_id")
  kategorieId            String  @map("kategorie_id")
  kategorie              String
  messpunkt              String
  passform               String
  unter                  Float
  ober                   Float
  einheit                String
  referenzDehnungsklasse Int     @map("referenz_dehnungsklasse")
  vertrauen              String?
  quelle                 String?

  version KonfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, kategorieId, messpunkt, passform])
  @@map("konfig_bereich")
  @@schema("app")
}

model KonfigMindest {
  id               Int     @id @default(autoincrement())
  versionId        Int     @map("version_id")
  kategorieId      String  @map("kategorie_id")
  messpunkt        String
  mindestCmKlasse0 Float   @map("mindest_cm_klasse0")
  hinweis          String?
  quelle           String?
  vertrauen        String?

  version KonfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, kategorieId, messpunkt])
  @@map("konfig_mindest")
  @@schema("app")
}

model KonfigDehnungsklasse {
  id         Int     @id @default(autoincrement())
  versionId  Int     @map("version_id")
  klasse     Int
  name       String
  dehnungVon Float   @map("dehnung_von")
  dehnungBis Float?  @map("dehnung_bis")
  beispiele  String?

  version KonfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, klasse])
  @@map("konfig_dehnungsklasse")
  @@schema("app")
}

model KonfigDehnungskorrektur {
  id         Int    @id @default(autoincrement())
  versionId  Int    @map("version_id")
  klasse     Int
  koerpernah Float?
  regulaer   Float?
  locker     Float?
  oversized  Float?

  version KonfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, klasse])
  @@map("konfig_dehnungskorrektur")
  @@schema("app")
}

model KonfigGewicht {
  id           Int    @id @default(autoincrement())
  versionId    Int    @map("version_id")
  kategorie    String
  brust        Float?
  taille       Float?
  huefte       Float?
  oberschenkel Float?
  oberarm      Float?

  version KonfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, kategorie])
  @@map("konfig_gewicht")
  @@schema("app")
}

model KonfigParameter {
  id         Int    @id @default(autoincrement())
  versionId  Int    @map("version_id")
  schluessel String
  wert       Float

  version KonfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, schluessel])
  @@map("konfig_parameter")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Shops und vermessene Artikel (Kleidungsmaße, keine Personendaten).
// Datenformat wie Schnittstellen-Doku v3 Abschnitt 8. Umfänge in cm (Flachmaß × 2).
// ---------------------------------------------------------------------------

model Shop {
  id              Int       @id @default(autoincrement())
  domain          String    @unique
  installiertAm   DateTime  @default(now()) @map("installiert_am")
  deinstalliertAm DateTime? @map("deinstalliert_am")

  artikel Artikel[]

  @@map("shop")
  @@schema("app")
}

model Artikel {
  id                      Int      @id @default(autoincrement())
  shopId                  Int      @map("shop_id")
  shopifyProduktId        String   @map("shopify_produkt_id")
  titel                   String
  artikelart              String
  schnitt                 String
  schnittQuelle           String   @map("schnitt_quelle")
  materialDehnungProzent  Float    @map("material_dehnung_prozent")
  materialZusammensetzung String?  @map("material_zusammensetzung")
  tailliert               Boolean  @default(false)
  bundTyp                 String?  @map("bund_typ")
  aermelTyp               String?  @map("aermel_typ")
  messhoeheBrustCm        Float    @default(2.5) @map("messhoehe_brust_cm")
  /// "entwurf" oder "vermessen"
  status                  String   @default("entwurf")
  aktualisiertAm          DateTime @updatedAt @map("aktualisiert_am")

  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  groessen     ArtikelGroesse[]
  vermessungen Vermessung[]

  @@unique([shopId, shopifyProduktId])
  @@map("artikel")
  @@schema("app")
}

model ArtikelGroesse {
  id                Int     @id @default(autoincrement())
  artikelId         Int     @map("artikel_id")
  groesse           String
  shopifyVarianteId String? @map("shopify_variante_id")
  reihenfolge       Int
  brust             Float?
  taille            Float?
  huefte            Float?
  oberschenkel      Float?
  oberarm           Float?
  schulter          Float?
  armlaenge         Float?
  gesamtlaenge      Float?

  artikel Artikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)

  @@unique([artikelId, groesse])
  @@map("artikel_groesse")
  @@schema("app")
}

model Vermessung {
  id             Int      @id @default(autoincrement())
  artikelId      Int      @map("artikel_id")
  teamMitgliedId Int?     @map("team_mitglied_id")
  /// "hand" oder später "programm"
  quelle         String
  erfasstAm      DateTime @default(now()) @map("erfasst_am")

  artikel      Artikel       @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  teamMitglied TeamMitglied? @relation(fields: [teamMitgliedId], references: [id], onDelete: SetNull)

  @@map("vermessung")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Team-Login für den internen Bereich (/intern): Passwort + Zwei-Faktor-Code (TOTP).
// Kein öffentliches Registrieren. Einladung per `npm run team:einladen`.
// ---------------------------------------------------------------------------

model TeamMitglied {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  name                  String
  /// scrypt-Hash, nie Klartext
  passwortHash          String?   @map("passwort_hash")
  /// TOTP-Geheimnis, verschlüsselt mit INTERN_SCHLUESSEL (AES-256-GCM)
  totpGeheimnis         String?   @map("totp_geheimnis")
  totpAktiv             Boolean   @default(false) @map("totp_aktiv")
  /// Letzter verwendeter Zeitschritt, damit ein Code nicht zweimal gilt
  letzterTotpSchritt    Int?      @map("letzter_totp_schritt")
  fehlversuche          Int       @default(0)
  gesperrtBis           DateTime? @map("gesperrt_bis")
  einrichtungTokenHash  String?   @unique @map("einrichtung_token_hash")
  einrichtungGueltigBis DateTime? @map("einrichtung_gueltig_bis")
  erstelltAm            DateTime  @default(now()) @map("erstellt_am")
  letzteAnmeldung       DateTime? @map("letzte_anmeldung")

  sitzungen    TeamSitzung[]
  vermessungen Vermessung[]

  @@map("team_mitglied")
  @@schema("app")
}

model TeamSitzung {
  id         Int      @id @default(autoincrement())
  /// SHA-256 des Cookie-Werts, der Wert selbst wird nie gespeichert
  tokenHash  String   @unique @map("token_hash")
  mitgliedId Int      @map("mitglied_id")
  gueltigBis DateTime @map("gueltig_bis")
  erstelltAm DateTime @default(now()) @map("erstellt_am")

  mitglied TeamMitglied @relation(fields: [mitgliedId], references: [id], onDelete: Cascade)

  @@map("team_sitzung")
  @@schema("app")
}

// Von Hand gepflegte Ergänzungen (Artikelarten, Zusatzgewichte), als JSON.
model KonfigErgaenzung {
  versionId Int  @id @map("version_id")
  daten     Json

  version KonfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("konfig_ergaenzung")
  @@schema("app")
}
